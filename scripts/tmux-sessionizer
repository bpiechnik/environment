#!/usr/bin/env bash

# Search roots come from an untracked local config so machine- and
# work-specific layouts stay out of git. See roots.conf.example.
#
#   DIR_ROOTS     -- list immediate subdirectories of each path
#   MARKER_ROOTS  -- "path:marker" pairs; lists dirs containing <marker>
#                    within 2 levels (e.g. a JS workspace: "$X:package.json")

DIR_ROOTS=("${HOME}/repos")
MARKER_ROOTS=()

ROOTS_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-sessionizer/roots.conf"
[ -f "$ROOTS_CONF" ] && source "$ROOTS_CONF"

selected_line=$(
    {
        for root in "${DIR_ROOTS[@]}"; do
            find "$root" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | \
                awk -F/ '{print $NF "\t" $0}'
        done

        for pair in "${MARKER_ROOTS[@]}"; do
            find "${pair%%:*}" -mindepth 1 -maxdepth 2 -name "${pair##*:}" -type f -print 2>/dev/null | \
                sed 's|/[^/]*$||' | \
                awk -F/ '{print $NF "\t" $0}'
        done
    } | awk '!NF || !seen[$0]++' | fzf --delimiter='\t' --with-nth=1 --height=${FZF_HEIGHT:-'40%'} --layout=reverse --border --prompt="Select Project: " --header="Projects / Services"
)

if [[ -z "$selected_line" ]]; then
    echo "No project selected."
    exit 0
fi
selected=$(echo "$selected_line" | awk -F'\t' '{print $2}')

if [[ -z "$selected" ]]; then
    echo "Failed to extract path."
    exit 1
fi

selected_name=$(basename "$selected" | tr . _)

if [[ -z $TMUX ]] && ! pgrep -x tmux > /dev/null; then
    echo "Starting new tmux server and session '$selected_name' in '$selected'..."
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$selected_name" 2> /dev/null; then
    echo "Creating new detached tmux session '$selected_name' in '$selected'..."
    tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z $TMUX ]]; then
    echo "Attaching to tmux session '$selected_name'..."
    tmux attach-session -t "$selected_name"
else
    echo "Switching to tmux session '$selected_name'..."
    tmux switch-client -t "$selected_name"
fi
