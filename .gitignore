.DS_Store

# The global excludesfile (~/.config/.gitignore) has a bare `nvim` rule, which
# would silently drop this repo's whole nvim config.
!nvim/
!nvim/**

# scratch files land in ~/.config/helix while editing; some have held real
# work data (a 137KB inspection dump). Only the real config is tracked.
helix/*.json

# machine-local / work-specific — never committed
.zshrc.local
*.local
roots.conf
.env
*secret*
*credential*
